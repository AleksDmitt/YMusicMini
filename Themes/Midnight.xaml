<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Dimensions are device-independent WPF units. -->
  <Color x:Key="Midnight.TextColor">#F5F3FF</Color>
  <Color x:Key="Midnight.MutedColor">#B4BCE8</Color>
  <Color x:Key="Midnight.AccentColor">#B7ADFF</Color>
  <SolidColorBrush x:Key="Midnight.Text" Color="{StaticResource Midnight.TextColor}"/>
  <SolidColorBrush x:Key="Midnight.Muted" Color="{StaticResource Midnight.MutedColor}"/>
  <SolidColorBrush x:Key="Midnight.Accent" Color="{StaticResource Midnight.AccentColor}"/>
  <SolidColorBrush x:Key="Midnight.Rail" Color="#3C446D"/>
  <LinearGradientBrush x:Key="Midnight.PanelFill" StartPoint="0,0" EndPoint=".35,1">
    <GradientStop Color="#F51A2038" Offset="0"/><GradientStop Color="#F70E152C" Offset=".34"/>
    <GradientStop Color="#F710172E" Offset=".7"/><GradientStop Color="#F5182443" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Midnight.PanelRim" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#E1C0FF" Offset="0"/><GradientStop Color="#7B86CF" Offset=".3"/>
    <GradientStop Color="#8299F7" Offset=".65"/><GradientStop Color="#BC94FF" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Midnight.AccentGradient" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#7D78FF" Offset="0"/><GradientStop Color="#8192FF" Offset=".55"/><GradientStop Color="#CFB5FF" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Midnight.ButtonRim" StartPoint="0,.1" EndPoint="1,.8">
    <GradientStop Color="#E48FF3" Offset="0"/><GradientStop Color="#A39BFF" Offset=".5"/><GradientStop Color="#72B9FF" Offset="1"/>
  </LinearGradientBrush>
  <RadialGradientBrush x:Key="Midnight.ButtonFill" GradientOrigin=".3,.15" Center=".3,.15" RadiusX="1" RadiusY="1">
    <GradientStop Color="#282744" Offset="0"/><GradientStop Color="#0E1730" Offset="1"/>
  </RadialGradientBrush>
  <PathGeometry x:Key="Midnight.Icon.Play" Figures="M 8,4.5 L 20,12 L 8,19.5 Z"/>
  <DrawingImage x:Key="Midnight.Image.Play"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="Transparent" Geometry="M 0,0 H 24 V 24 H 0 Z"/><GeometryDrawing Brush="{StaticResource Midnight.Text}" Geometry="{StaticResource Midnight.Icon.Play}"/></DrawingGroup></DrawingImage.Drawing></DrawingImage>
  <PathGeometry x:Key="Midnight.Icon.Pause" Figures="M 6,5 H 9.5 V 19 H 6 Z M 14.5,5 H 18 V 19 H 14.5 Z"/>
  <DrawingImage x:Key="Midnight.Image.Pause"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="Transparent" Geometry="M 0,0 H 24 V 24 H 0 Z"/><GeometryDrawing Brush="{StaticResource Midnight.Text}" Geometry="{StaticResource Midnight.Icon.Pause}"/></DrawingGroup></DrawingImage.Drawing></DrawingImage>
  <PathGeometry x:Key="Midnight.Icon.Previous" Figures="M 4,5 H 6.5 V 19 H 4 Z M 19.5,4.5 L 8,12 L 19.5,19.5 Z"/>
  <DrawingImage x:Key="Midnight.Image.Previous"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="Transparent" Geometry="M 0,0 H 24 V 24 H 0 Z"/><GeometryDrawing Brush="{StaticResource Midnight.Text}" Geometry="{StaticResource Midnight.Icon.Previous}"/></DrawingGroup></DrawingImage.Drawing></DrawingImage>
  <PathGeometry x:Key="Midnight.Icon.Next" Figures="M 17.5,5 H 20 V 19 H 17.5 Z M 4.5,4.5 L 16,12 L 4.5,19.5 Z"/>
  <DrawingImage x:Key="Midnight.Image.Next"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="Transparent" Geometry="M 0,0 H 24 V 24 H 0 Z"/><GeometryDrawing Brush="{StaticResource Midnight.Text}" Geometry="{StaticResource Midnight.Icon.Next}"/></DrawingGroup></DrawingImage.Drawing></DrawingImage>
  <PathGeometry x:Key="Midnight.Icon.Shuffle" Figures="M 3,6 H 5 C 10,6 13,18 18,18 H 21 M 17.5,14.5 L 21,18 L 17.5,21.5 M 3,18 H 5 C 7.5,18 9,15 10,13 M 14,7 C 15.4,6 16.5,6 18,6 H 21 M 17.5,2.5 L 21,6 L 17.5,9.5"/>
  <DrawingImage x:Key="Midnight.Image.Shuffle"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="Transparent" Geometry="M 0,0 H 24 V 24 H 0 Z"/><GeometryDrawing Geometry="{StaticResource Midnight.Icon.Shuffle}"><GeometryDrawing.Pen><Pen Brush="{StaticResource Midnight.Text}" Thickness="1.65" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen></GeometryDrawing></DrawingGroup></DrawingImage.Drawing></DrawingImage>
  <PathGeometry x:Key="Midnight.Icon.Repeat" Figures="M 17,2 L 21,6 L 17,10 M 21,6 H 8 C 4.7,6 3,8 3,11 M 7,22 L 3,18 L 7,14 M 3,18 H 16 C 19.3,18 21,16 21,13"/>
  <DrawingImage x:Key="Midnight.Image.Repeat"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="Transparent" Geometry="M 0,0 H 24 V 24 H 0 Z"/><GeometryDrawing Geometry="{StaticResource Midnight.Icon.Repeat}"><GeometryDrawing.Pen><Pen Brush="{StaticResource Midnight.Text}" Thickness="1.65" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen></GeometryDrawing></DrawingGroup></DrawingImage.Drawing></DrawingImage>
  <PathGeometry x:Key="Midnight.Icon.Volume" Figures="M 3,9 H 7 L 12,5 V 19 L 7,15 H 3 Z M 15,8 C 17.7,10 17.7,14 15,16 M 18,5 C 22.5,8.5 22.5,15.5 18,19"/>
  <DrawingImage x:Key="Midnight.Image.Volume"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="Transparent" Geometry="M 0,0 H 24 V 24 H 0 Z"/><GeometryDrawing Geometry="{StaticResource Midnight.Icon.Volume}"><GeometryDrawing.Pen><Pen Brush="{StaticResource Midnight.Text}" Thickness="1.65" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen></GeometryDrawing></DrawingGroup></DrawingImage.Drawing></DrawingImage>
  <PathGeometry x:Key="Midnight.Icon.VolumeMute" Figures="M 3,9 H 7 L 12,5 V 19 L 7,15 H 3 Z M 16,9 L 22,15 M 22,9 L 16,15"/>
  <DrawingImage x:Key="Midnight.Image.VolumeMute"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="Transparent" Geometry="M 0,0 H 24 V 24 H 0 Z"/><GeometryDrawing Geometry="{StaticResource Midnight.Icon.VolumeMute}"><GeometryDrawing.Pen><Pen Brush="{StaticResource Midnight.Text}" Thickness="1.65" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen></GeometryDrawing></DrawingGroup></DrawingImage.Drawing></DrawingImage>
  <PathGeometry x:Key="Midnight.Icon.Pin" Figures="M 16,3 L 21,8 L 17,9 L 13,13 L 14,17 L 11,20 L 4,13 L 7,10 L 11,11 L 15,7 Z M 7.5,16.5 L 3,21"/>
  <DrawingImage x:Key="Midnight.Image.Pin"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="Transparent" Geometry="M 0,0 H 24 V 24 H 0 Z"/><GeometryDrawing Geometry="{StaticResource Midnight.Icon.Pin}"><GeometryDrawing.Pen><Pen Brush="{StaticResource Midnight.Text}" Thickness="1.65" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen></GeometryDrawing></DrawingGroup></DrawingImage.Drawing></DrawingImage>
  <PathGeometry x:Key="Midnight.Icon.Settings" Figures="M 12.000,4.400 L 13.227,2.680 L 14.433,2.920 L 15.597,3.316 L 16.700,3.859 L 16.627,5.971 L 17.374,6.626 L 19.458,6.278 L 20.141,7.300 L 20.684,8.403 L 21.080,9.567 L 19.535,11.008 L 19.600,12.000 L 21.320,13.227 L 21.080,14.433 L 20.684,15.597 L 20.141,16.700 L 18.029,16.627 L 17.374,17.374 L 17.722,19.458 L 16.700,20.141 L 15.597,20.684 L 14.433,21.080 L 12.992,19.535 L 12.000,19.600 L 10.773,21.320 L 9.567,21.080 L 8.403,20.684 L 7.300,20.141 L 7.373,18.029 L 6.626,17.374 L 4.542,17.722 L 3.859,16.700 L 3.316,15.597 L 2.920,14.433 L 4.465,12.992 L 4.400,12.000 L 2.680,10.773 L 2.920,9.567 L 3.316,8.403 L 3.859,7.300 L 5.971,7.373 L 6.626,6.626 L 6.278,4.542 L 7.300,3.859 L 8.403,3.316 L 9.567,2.920 L 11.008,4.465 Z M 15.2,12 A 3.2,3.2 0 1 0 8.8,12 A 3.2,3.2 0 1 0 15.2,12 Z"/>
  <DrawingImage x:Key="Midnight.Image.Settings"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="Transparent" Geometry="M 0,0 H 24 V 24 H 0 Z"/><GeometryDrawing Geometry="{StaticResource Midnight.Icon.Settings}"><GeometryDrawing.Pen><Pen Brush="{StaticResource Midnight.Text}" Thickness="1.65" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen></GeometryDrawing></DrawingGroup></DrawingImage.Drawing></DrawingImage>
  <PathGeometry x:Key="Midnight.Icon.ChevronUp" Figures="M 5,15 L 12,8 L 19,15"/>
  <DrawingImage x:Key="Midnight.Image.ChevronUp"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="Transparent" Geometry="M 0,0 H 24 V 24 H 0 Z"/><GeometryDrawing Geometry="{StaticResource Midnight.Icon.ChevronUp}"><GeometryDrawing.Pen><Pen Brush="{StaticResource Midnight.Text}" Thickness="1.65" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen></GeometryDrawing></DrawingGroup></DrawingImage.Drawing></DrawingImage>
  <PathGeometry x:Key="Midnight.Icon.ChevronDown" Figures="M 5,9 L 12,16 L 19,9"/>
  <DrawingImage x:Key="Midnight.Image.ChevronDown"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="Transparent" Geometry="M 0,0 H 24 V 24 H 0 Z"/><GeometryDrawing Geometry="{StaticResource Midnight.Icon.ChevronDown}"><GeometryDrawing.Pen><Pen Brush="{StaticResource Midnight.Text}" Thickness="1.65" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen></GeometryDrawing></DrawingGroup></DrawingImage.Drawing></DrawingImage>
  <PathGeometry x:Key="Midnight.Icon.Close" Figures="M 6,6 L 18,18 M 18,6 L 6,18"/>
  <DrawingImage x:Key="Midnight.Image.Close"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="Transparent" Geometry="M 0,0 H 24 V 24 H 0 Z"/><GeometryDrawing Geometry="{StaticResource Midnight.Icon.Close}"><GeometryDrawing.Pen><Pen Brush="{StaticResource Midnight.Text}" Thickness="1.65" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen></GeometryDrawing></DrawingGroup></DrawingImage.Drawing></DrawingImage>

  <Style x:Key="Midnight.Panel" TargetType="{x:Type ContentControl}">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ContentControl}">
      <Grid>
        <Border CornerRadius="28" Background="{StaticResource Midnight.PanelFill}">
          <Border.Effect><DropShadowEffect Color="#778AFF" ShadowDepth="0" BlurRadius="18" Opacity=".34"/></Border.Effect>
        </Border>
        <Border CornerRadius="28" IsHitTestVisible="False">
          <Border.Background><RadialGradientBrush Center=".08,0" GradientOrigin=".08,0" RadiusX=".8" RadiusY=".8"><GradientStop Color="#1FB9A7FF" Offset="0"/><GradientStop Color="#00B9A7FF" Offset="1"/></RadialGradientBrush></Border.Background>
        </Border>
        <Border CornerRadius="28" IsHitTestVisible="False">
          <Border.Background><RadialGradientBrush Center="1,1" GradientOrigin="1,1" RadiusX=".7" RadiusY=".7"><GradientStop Color="#1F688CFF" Offset="0"/><GradientStop Color="#00688CFF" Offset="1"/></RadialGradientBrush></Border.Background>
        </Border>
        <Border CornerRadius="28" BorderThickness="1" BorderBrush="{StaticResource Midnight.PanelRim}" IsHitTestVisible="False"/>
        <Border CornerRadius="26" Margin="2" BorderThickness="1" BorderBrush="#24B3B6FF" IsHitTestVisible="False"/>
        <ContentPresenter Margin="{TemplateBinding Padding}"/>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style x:Key="Midnight.IconButtonBase" TargetType="{x:Type ButtonBase}">
    <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
    <Setter Property="Foreground" Value="{StaticResource Midnight.Text}"/>
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ButtonBase}">
      <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="16">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#343E497B"/><Setter TargetName="Face" Property="BorderBrush" Value="#648E9CEC"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#DFD6FF"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value=".65"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value=".35"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Midnight.IconButton" TargetType="{x:Type Button}" BasedOn="{StaticResource Midnight.IconButtonBase}"/>
  <Style x:Key="Midnight.IconToggle" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource Midnight.IconButtonBase}">
    <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{StaticResource Midnight.Accent}"/><Setter Property="BorderBrush" Value="#888F9BFF"/><Setter Property="Background" Value="#332B3263"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="Midnight.PrimaryButton" TargetType="{x:Type Button}">
    <Setter Property="Width" Value="56"/><Setter Property="Height" Value="56"/>
    <Setter Property="Foreground" Value="{StaticResource Midnight.Text}"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Button}">
      <Grid>
        <Ellipse x:Name="Rim" Margin="1.5" Fill="{StaticResource Midnight.ButtonFill}" Stroke="{DynamicResource SharedButtonGradient}" StrokeThickness="2.2">
          <Ellipse.Effect><DropShadowEffect Color="#9D93FF" ShadowDepth="0" BlurRadius="16" Opacity=".4"/></Ellipse.Effect>
        </Ellipse>
        <Ellipse Margin="3.7" Stroke="#14C0BFFF" StrokeThickness="1" IsHitTestVisible="False"/>
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Rim" Property="Fill" Value="#323354"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Rim" Property="StrokeThickness" Value="3.2"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Rim" Property="Opacity" Value=".65"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".35"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Horizontal sliders: live WPF parts, rail=4, thumb=12. -->
  <Style x:Key="Midnight.Slider" TargetType="{x:Type Slider}">
    <Setter Property="Height" Value="20"/><Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="100"/>
    <Setter Property="IsMoveToPointEnabled" Value="True"/><Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Slider}">
      <Grid Background="Transparent">
        <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}" Orientation="Horizontal">
          <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False" IsTabStop="False"><RepeatButton.Template><ControlTemplate TargetType="{x:Type RepeatButton}"><Border Height="4" CornerRadius="2" Background="{DynamicResource SharedButtonGradient}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb Width="12" Height="12" Cursor="Hand"><Thumb.Template><ControlTemplate TargetType="{x:Type Thumb}"><Ellipse Fill="#F6F3FF" Stroke="{StaticResource Midnight.ButtonRim}" StrokeThickness="2"><Ellipse.Effect><DropShadowEffect Color="#969FFF" BlurRadius="7" ShadowDepth="0" Opacity=".5"/></Ellipse.Effect></Ellipse></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False" IsTabStop="False"><RepeatButton.Template><ControlTemplate TargetType="{x:Type RepeatButton}"><Border Height="4" CornerRadius="2" Background="{StaticResource Midnight.Rail}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
        </Track>
      </Grid>
      <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".35"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
